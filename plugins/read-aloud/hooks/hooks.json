{
  "description": "Reads each finished Claude reply aloud with the OS voice",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/speak.js"],
            "async": true,
            "statusMessage": "Reading reply aloud"
          }
        ]
      }
    ]
  }
}
